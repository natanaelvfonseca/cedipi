POSTGRES_ADMIN_URL=postgresql://postgres:SENHA@HOST:5432/postgres
DATABASE_URL=postgresql://postgres:SENHA@HOST:5432/cedipi_core
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_INSTANCE_ID=
N8N_AGENDA_WEBHOOK_URL=
N8N_AGENDA_WEBHOOK_SECRET=
N8N_AI_CONTROL_WEBHOOK_URL=
N8N_AI_CONTROL_WEBHOOK_SECRET=
N8N_INTERNAL_API_SECRET=
AUTH_SESSION_TTL_HOURS=12
CEDIPI_INITIAL_ADMIN_NAME=
CEDIPI_INITIAL_ADMIN_EMAIL=
CEDIPI_INITIAL_ADMIN_PASSWORD=

# Keep n8n until Lara native processing is live.
CEDIPI_AI_CONTROL_BACKEND=n8n

# Future native Google Calendar scheduling (do not switch until reviewed).
CEDIPI_APPOINTMENTS_BACKEND=n8n
CEDIPI_GOOGLE_CLIENT_ID=
CEDIPI_GOOGLE_CLIENT_SECRET=
CEDIPI_GOOGLE_REFRESH_TOKEN=

# --- Lara native (all outbound switches disabled by default) ---
LARA_INGEST_ENABLED=false
LARA_WEBHOOK_SECRET=
LARA_OUTBOUND_ENABLED=false
LARA_CUTOVER_CONFIRMED=false
LARA_OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Single-contact homologation (not general production cutover).
LARA_TEST_MODE=false
LARA_TEST_PHONE=
LARA_TEST_REMOTE_JID=
LARA_TEST_MIN_TIMESTAMP=

# Complete Google Calendar setup requires an authorized Google account
# with freeBusy + event create scopes, for all three doctor's calendars.
# The existing Google calendar IDs are saved with the doctors in PostgreSQL.
# NEVER paste secret values in the public GitHub repository.
